---
import { site } from '../site';

/**
 * Work-in-progress notice, shown on every page while site.underConstruction
 * is true.
 *
 * Static page content, so it is a plain <aside> with an accessible name —
 * not role="status" or role="alert". Those are for messages that appear in
 * response to something the visitor did; using them for text that is present
 * on load makes a screen reader announce it over whatever the person was
 * already reading.
 */
---

<aside class="construction" aria-label="Site status">
  <p class="construction__inner page">
    <strong>Work in progress.</strong> Some sections are still placeholder text
    while I build this out. The contact form works, so if something here is
    relevant to you, <a href="/contact/">get in touch</a> — or email
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>
</aside>

<style>
  .construction {
    background-color: var(--sunken);
    border-block-end: 2px solid var(--accent);
  }

  /* Width and gutters come from .page alone. Adding a max-inline-size here
     too would win over it and pull the banner out of alignment with the
     header and the content below. */
  .construction__inner {
    padding-block: var(--space-2xs);
    font-size: var(--step--1);
  }

  .construction a {
    /* These are inline links inside a sentence, so SC 2.5.8 target size
       does not apply — but the underline needs to be unmistakable at this
       smaller size. */
    text-decoration-thickness: max(1px, 0.08em);
  }
</style>

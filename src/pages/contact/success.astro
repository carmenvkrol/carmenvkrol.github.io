---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../site';
---

<BaseLayout
  title="Message sent"
  description="Your message has been sent. Carmen usually replies within two working days."
>
  <!--
    This page exists for the no-JavaScript path: Web3Forms redirects here
    after a native form POST. With JavaScript the visitor never leaves
    /contact/, so there is nothing here worth indexing.
  -->
  <meta slot="head" name="robots" content="noindex" />

  <div class="page region">
    <h1>Thank you — your message is on its way</h1>
    <div class="prose">
      <p>
        I read everything that comes through the form and usually reply within
        two working days.
      </p>
      <p>
        If you need to add something, write to
        <a href={`mailto:${site.email}`}>{site.email}</a> and it will land in
        the same place.
      </p>
      <p>
        <a href="/">Back to the home page</a>
      </p>
    </div>
  </div>
</BaseLayout>

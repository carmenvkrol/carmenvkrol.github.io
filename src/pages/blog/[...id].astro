---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate, site } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <div class="page region">
    <article class="post">
      <header class="post__header">
        <p class="eyebrow">
          <a href="/blog/">Blog</a>
        </p>
        <h1>{post.data.title}</h1>
        <p class="post__meta">
          Published
          <time datetime={isoDate(post.data.pubDate)}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <>
              {' · updated '}
              <time datetime={isoDate(post.data.updatedDate)}>
                {formatDate(post.data.updatedDate)}
              </time>
            </>
          )}
        </p>
      </header>

      <div class="prose post__body">
        <Content />
      </div>
    </article>

    <!-- Standing in for comments. Every post ends with a way to reply. -->
    <aside class="post__cta note" aria-labelledby="cta-heading">
      <h2 id="cta-heading">Questions about this?</h2>
      <p>
        There are no comments on this site, but I read every message.
        <a href="/contact/">Get in touch</a> or email
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .post {
    max-inline-size: var(--measure);
  }

  .post__header {
    margin-block-end: var(--space-l);
  }

  .post__header h1 {
    font-size: var(--step-4);
    margin-block: var(--space-2xs) var(--space-2xs);
  }

  .post__meta {
    font-size: var(--step--1);
    color: var(--muted);
  }

  /* Same typeface as the rest of the site, one step larger for long-form
     reading. The measure is already capped by .prose. */
  .post__body {
    font-size: var(--step-1);
  }

  /* With one typeface, size and weight carry the heading levels on their
     own, so each level sits a step above the next. h4 matches the body size
     and is set apart by weight. */
  .post__body :global(h2) {
    font-size: var(--step-3);
    margin-block-start: var(--space-l);
  }

  .post__body :global(h3) {
    font-size: var(--step-2);
    margin-block-start: var(--space-m);
  }

  .post__body :global(h4) {
    font-size: var(--step-1);
    margin-block-start: var(--space-m);
  }

  /* Screenshots. Capping the height keeps a full phone screen from filling
     several viewports. object-fit scales it down inside its box rather than
     overriding the width attribute, which would leave lazy images with no
     reserved space before they load and shift the text around them.

     The outline shows where a light screenshot ends against the light page.
     It is four stacked drop-shadows rather than a border because a border
     would trace the box, and a scaled-down screenshot is narrower than its
     box. Each shadow is offset one pixel and applied to the result of the
     one before, so the corners fill in and the line follows the painted
     image exactly. */
  .post__body :global(img) {
    max-block-size: 40rem;
    object-fit: contain;
    object-position: left top;
    filter: drop-shadow(1px 0 0 var(--edge)) drop-shadow(-1px 0 0 var(--edge))
      drop-shadow(0 1px 0 var(--edge)) drop-shadow(0 -1px 0 var(--edge));
  }

  /* Forced-colors mode leaves filter colours alone, so the outline is set
     to the user's own text colour. */
  @media (forced-colors: active) {
    .post__body :global(img) {
      filter: drop-shadow(1px 0 0 CanvasText) drop-shadow(-1px 0 0 CanvasText)
        drop-shadow(0 1px 0 CanvasText) drop-shadow(0 -1px 0 CanvasText);
    }
  }

  .post__body :global(pre) {
    overflow-x: auto;
    padding: var(--space-s);
    background-color: var(--sunken);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .post__body :global(code) {
    font-family: var(--font-mono);
  }

  .post__body :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    background-color: var(--sunken);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }

  .post__body :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: var(--space-s);
    border-inline-start: 3px solid var(--edge);
    color: var(--muted);
  }

  .post__cta {
    margin-block-start: var(--space-xl);
    max-inline-size: var(--measure);
  }

  .post__cta h2 {
    font-size: var(--step-1);
    margin-block-end: var(--space-3xs);
  }
</style>

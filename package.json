{
  "name": "carmenkrol-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:a11y": "playwright test",
    "test:html": "html-validate \"dist/**/*.html\"",
    "verify": "npm run build && npm run test:html && npm run test:a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "html-validate": "^11.15.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.0",
    "sirv-cli": "^3.0.1",
    "typescript": "^6.0.3"
  }
}
